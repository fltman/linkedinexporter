# LinkedIn Credentials (optional - can use interactive login)
# WARNING: Only works if you DO NOT have 2-Factor Authentication enabled
# If you have 2FA, leave these blank and use manual login
# LINKEDIN_EMAIL=your.email@example.com
# LINKEDIN_PASSWORD=your_password

# LinkedIn Profile (optional)
# Your LinkedIn profile URL - if not set, uses your logged-in profile
# Examples:
#   LINKEDIN_PROFILE=https://www.linkedin.com/in/andersbjarby/
#   LINKEDIN_PROFILE=https://www.linkedin.com/in/username/
# LINKEDIN_PROFILE=

# Export Settings
# Where to save exports (default: exports)
# Examples:
#   OUTPUT_DIR=exports
#   OUTPUT_DIR=/Users/andersbj/Documents/LinkedIn_Backups
#   OUTPUT_DIR=~/Dropbox/LinkedIn_Archive
OUTPUT_DIR=exports

# Rate limiting (seconds between actions)
# Increase these for very large exports (200+ scrolls) to avoid rate limiting
RATE_LIMIT_MIN_DELAY=2
RATE_LIMIT_MAX_DELAY=5

# For large exports with thousands of posts, consider:
# RATE_LIMIT_MIN_DELAY=3
# RATE_LIMIT_MAX_DELAY=7
